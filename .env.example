# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/beautybook"
# 32+ random characters: openssl rand -hex 32
SESSION_SECRET=""
# Public base URL used in share links
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Root domain for business subdomains (michal.beautybook.co.il). Leave empty to use /b/<slug>.
# Needs a wildcard DNS record (*.beautybook.co.il) pointing at the app.
NEXT_PUBLIC_ROOT_DOMAIN=""
# Verification code from Google Search Console (optional)
GOOGLE_SITE_VERIFICATION=""


# Payment gateway. "test" simulates the hosted card page; no money moves.
BILLING_PROVIDER="test"
# Bearer token for the daily billing job at /api/cron/billing
CRON_SECRET=""
